# WebWise AI — Environment Configuration Template
# ================================================
# Copy this file to .env and edit as needed.
# The .env file is gitignored — never commit real API keys!

# ── Ollama Local Model settings ───────────────────────────────────────────────
MODEL_NAME=qwen3:1.7b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ── Groq Cloud Provider (Optional) ──────────────────────────────────────────
# Free API key from: https://console.groq.com/keys
# If not set, WebWise AI runs 100% locally using Ollama.
GROQ_API_KEY=

# Supported models: qwen/qwen3.8-27b, openai/gpt-oss-120b, openai/gpt-oss-20b
GROQ_MODEL=qwen/qwen3.8-27b

# Default provider if not specified in the request ('ollama' or 'groq')
DEFAULT_PROVIDER=ollama

# ── Backend server ────────────────────────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=7864

# ── Input limits ──────────────────────────────────────────────────────────────
MAX_CONTENT_CHARS=50000
MAX_TITLE_CHARS=500

# ── Model generation ──────────────────────────────────────────────────────────
TEMPERATURE=0.7
MAX_TOKENS=1024
REQUEST_TIMEOUT=120

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
