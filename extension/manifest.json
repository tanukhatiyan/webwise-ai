{
  "manifest_version": 3,
  "name": "WebWise AI",
  "version": "1.0.0",
  "description": "Summarize any webpage instantly using a local AI model. No cloud APIs, no data leaves your machine.",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "WebWise AI — Summarize this page"
  },

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],

  "host_permissions": [
    "http://127.0.0.1:7864/*",
    "http://localhost:7864/*"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http://127.0.0.1:7864 http://localhost:7864"
  }
}
